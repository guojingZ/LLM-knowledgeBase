    {
      "proposal_id": "candidate-0011",
      "action": "new",
      "target_ref": "scenario://如何构建可运行的企业语义体系",
      "node": {
        "id": "如何构建可运行的企业语义体系",
        "sources": [
          "raw/accepted/知识图谱和本体的区别与联系.md"
        ],
        "define": "在企业数据已连接却仍依赖少数人做跨部门判断、或智能体将进入业务时，如何建设可运行的企业语义体系：先定义本体，再把不同系统的真实数据映射进知识图谱形成事实，用例外反向修正模型，最后复用语义模块，使数据从可存储、可查询、可连接走向可解释、可校验、可推理、可执行。",
        "trigger": "企业系统越来越多、接口越来越丰富、数据关联越来越复杂，但跨部门判断仍然依赖少数熟悉业务的人；或者智能体开始进入真实业务，过去隐藏在制度、经验和人员默契中的边界必须更明确地表达出来。",
        "goal": "让本体与知识图谱在场景中共同生长，并进入流程与智能体执行链路，使企业的数据从可存储、可查询和可连接，走向可解释、可校验、可推理和可执行。",
        "composition": [
          {
            "phase": "从闭环业务场景开始定义本体",
            "uses": [
              "concept://场景闭环建设",
              "concept://模式层与事实层"
            ],
            "rule": "先在全局蓝图约束下选能够形成闭环的业务场景，明确场景中的关键问题，据此决定本体需要定义哪些对象、关系和规则。",
            "key_points": [
              "脱离具体任务讨论“客户的完整定义”会陷入长时间争论",
              "全局蓝图保证不同场景不会各自建模",
              "本体定义的对象、关系和规则由场景中的关键问题决定"
            ]
          },
          {
            "phase": "把真实数据映射进知识图谱形成事实",
            "uses": [
              "concept://模式层与事实层"
            ],
            "rule": "本体定义完成后，把不同系统中的数据映射到相应概念，进入知识图谱并形成具体事实。",
            "key_points": [
              "真实数据会很快暴露模型中的问题",
              "一台设备可能由多个部门共同负责，一项规则可能只适用于特定区域和时间"
            ]
          },
          {
            "phase": "用例外反向修正并复用语义模块",
            "uses": [
              "concept://场景闭环建设",
              "concept://语义模块复用"
            ],
            "rule": "用真实数据中的例外推动本体调整，再用本体约束反向发现知识图谱的数据问题；场景跑通后语义模块可被其他场景复用。",
            "key_points": [
              "数据问题示例：缺少责任主体、关系方向错误、状态互相矛盾、工单没有处理结果",
              "设备模块可进入资产管理，人员与权限模块可进入安全管理"
            ]
          },
          {
            "phase": "接入智能体执行链路",
            "uses": [
              "concept://智能体业务执行"
            ],
            "rule": "把语义与规则连接到业务流程和智能体技能，执行中产生的新状态、新事件和新证据再返回知识图谱，并推动本体和规则继续修正。",
            "key_points": [
              "业务场景提出问题，本体定义判断所需对象、关系和规则，知识图谱承载事实，智能体依据事实和规则推动流程",
              "运行结果反向更新图谱并检验本体，数据才走向可解释、可校验、可推理、可执行"
            ]
          }
        ],
        "tags": [
          "企业语义体系",
          "本体",
          "知识图谱",
          "场景闭环",
          "智能体"
        ]
      },
      "observation_ids": [
        "obs-0011"
      ],
      "supports": [
        {
          "source_id": "src-4cfc5117652611c6",
          "path": "raw/accepted/知识图谱和本体的区别与联系.md",
          "sha256": "e6ca192d49f87c2b121462a42dce1fa1e3ca1f663962d268b317496da6a85abd",
          "line_start": 127,
          "line_end": 127,
          "excerpt": "更稳妥的建设方式，是在全局蓝图的约束下，从能够形成闭环的业务场景开始。",
          "support_field": "define"
        },
        {
          "source_id": "src-4cfc5117652611c6",
          "path": "raw/accepted/知识图谱和本体的区别与联系.md",
          "sha256": "e6ca192d49f87c2b121462a42dce1fa1e3ca1f663962d268b317496da6a85abd",
          "line_start": 197,
          "line_end": 197,
          "excerpt": "当这种协同进一步进入流程和智能体执行链路，企业的数据才会从可存储、可查询和可连接，继续走向可解释、可校验、可推理和可执行。",
          "support_field": "define"
        }
      ],
