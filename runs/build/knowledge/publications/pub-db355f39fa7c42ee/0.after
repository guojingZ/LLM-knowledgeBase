              "考察存在有哪些种类或形式，区分质料与形式",
              "提炼事物的本质属性与共相",
              "区分第一实体（具体个体）与第二实体（抽象类别）"
            ]
          },
          "output": [
            "对事物存在本质与基本结构的界定",
            "抽象出的共相与第二实体概念"
          ]
        },
        "decomposition": [
          {
            "step": "研究存在本身",
            "uses": "concept://事物认知",
            "why": "单纯研究事物本体是自然科学的起源，先确认事物是什么"
          },
          {
            "step": "抽象理解这种存在",
            "uses": "concept://本源抽象",
            "why": "形而上学研究的重点是如何抽象地理解客观存在的事物和现象"
          }
        ],
        "relations": {
