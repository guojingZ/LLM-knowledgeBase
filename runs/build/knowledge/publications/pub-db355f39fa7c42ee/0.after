            "不同系统中已有的业务数据"
          ],
          "process": {
            "steps": [
              "在全局蓝图约束下，从能够形成闭环的业务场景开始",
              "明确场景中的关键问题，确定本体需要定义哪些对象、关系和规则",
              "把不同系统中的数据映射到相应概念，进入知识图谱并形成具体事实",
              "用真实数据暴露的例外推动本体继续调整",
              "用本体中的约束反向发现知识图谱中的数据问题",
              "循环往复，使本体与知识图谱逐步形成稳定协同"
            ]
          },
          "output": [
            "稳定协同的本体与知识图谱",
            "可供后续场景复用的语义模块"
          ]
        },
        "tags": [
          "场景闭环",
          "全局蓝图",
          "共同生长",
          "企业语义体系"
        ]
      },
      "observation_ids": [
