        ],
        "define": "智能体进入企业真实业务开展行动所需的对象识别、事实获取、规则边界与行动条件；本体规定机器可以相信什么、如何解释事实，以及在什么条件下可以采取行动。",
        "type": "知识工程",
        "ipo": {
          "input": [
            "用户业务任务",
            "跨系统的业务事实"
          ],
          "process": {
            "steps": [
              "理解用户任务",
              "查询不同系统",
              "识别业务对象",
              "关联相关事实",
              "判断当前状态",
              "选择适用规则",
              "调用业务工具",
              "推动流程继续运行"
            ]
          },
          "output": [
            "可以被系统执行的行动与流程推进"
          ]
        },
        "relations": {
          "related_to": [
            "entity://大模型"
          ]
        },
        "tags": [
